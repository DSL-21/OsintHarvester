<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    android:background="#212121"
    tools:context=".MainActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- App title -->
        <TextView
            android:id="@+id/app_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:gravity="center_horizontal"
            android:layout_marginBottom="16dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/app_tagline"
            android:textColor="#BDBDBD"
            android:textSize="13sp"
            android:layout_marginBottom="12dp"/>

        <!-- Target URL -->
        <EditText
            android:id="@+id/url_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/target_url_hint"
            android:textColorHint="#9E9E9E"
            android:inputType="textUri"
            android:background="#2C2C2C"
            android:padding="12dp"
            android:textColor="#E0E0E0"
            android:layout_marginBottom="8dp"/>

        <!-- Scan controls -->
        <Button
            android:id="@+id/scan_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/scan_button"
            android:backgroundTint="#4CAF50"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:layout_marginBottom="16dp"/>

        <Button
            android:id="@+id/cancel_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/cancel_button"
            android:backgroundTint="#616161"
            android:textColor="#FFFFFF"
            android:visibility="gone"
            android:layout_marginBottom="12dp"/>

        <!-- Progress and status -->
        <ProgressBar
            android:id="@+id/progress_bar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone"
            android:indeterminate="true"
            android:indeterminateTint="#03A9F4"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:id="@+id/status_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/status_ready"
            android:textColor="#BDBDBD"
            android:textSize="14sp"
            android:gravity="center_horizontal"
            android:layout_marginBottom="16dp"/>

        <!-- Basic collection options -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/section_basic"
            android:textColor="#FFC107"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#2C2C2C"
            android:padding="8dp"
            android:layout_marginBottom="16dp">

            <CheckBox android:id="@+id/emails_check"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/option_emails"
                android:textColor="#E0E0E0"
                android:buttonTint="#FFC107"/>
            <CheckBox android:id="@+id/phones_check"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/option_phones"
                android:textColor="#E0E0E0"
                android:buttonTint="#FFC107"/>
            <CheckBox android:id="@+id/social_check"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/option_social"
                android:textColor="#E0E0E0"
                android:buttonTint="#FFC107"/>
            <CheckBox android:id="@+id/meta_tags_check"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/option_meta"
                android:textColor="#E0E0E0"
                android:buttonTint="#FFC107"/>
            <CheckBox android:id="@+id/comments_check"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/option_comments"
                android:textColor="#E0E0E0"
                android:buttonTint="#FFC107"/>
            <CheckBox android:id="@+id/http_headers_check"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/option_headers"
                android:textColor="#E0E0E0"
                android:buttonTint="#FFC107"/>
        </LinearLayout>

        <!-- Advanced OSINT -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/section_advanced"
            android:textColor="#FFC107"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#2C2C2C"
            android:padding="8dp"
            android:layout_marginBottom="16dp">

            <CheckBox android:id="@+id/subdomains_check"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/option_subdomains"
                android:textColor="#E0E0E0"
                android:buttonTint="#FFC107"/>

            <CheckBox android:id="@+id/deep_crawl_check"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/option_deep_crawl"
                android:textColor="#E0E0E0"
                android:buttonTint="#FFC107"/>

            <!-- Crawl depth control -->
            <TextView
                android:id="@+id/depth_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="4dp"
                android:textColor="#BDBDBD"
                android:text="@string/crawl_depth_initial"
                android:textSize="14sp"/>

            <SeekBar
                android:id="@+id/depth_seekbar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:progressTint="#03A9F4"
                android:thumbTint="#03A9F4"/>

            <CheckBox android:id="@+id/wayback_check"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/option_wayback"
                android:textColor="#E0E0E0"
                android:buttonTint="#FFC107"/>
            <CheckBox android:id="@+id/reverse_ip_check"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/option_reverse_ip"
                android:textColor="#E0E0E0"
                android:buttonTint="#FFC107"/>
            <CheckBox android:id="@+id/dns_records_check"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/option_dns"
                android:textColor="#E0E0E0"
                android:buttonTint="#FFC107"/>
            <CheckBox android:id="@+id/whois_check"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/option_rdap"
                android:textColor="#E0E0E0"
                android:buttonTint="#FFC107"/>

            <!-- Public metadata file lookup -->
            <CheckBox android:id="@+id/file_detect_check"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/option_public_files"
                android:textColor="#E0E0E0"
                android:buttonTint="#FFC107"/>

        </LinearLayout>

        <!-- Security analysis -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/section_security"
            android:textColor="#FFC107"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#2C2C2C"
            android:padding="8dp"
            android:layout_marginBottom="16dp">

            <CheckBox android:id="@+id/ssl_check"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/option_tls"
                android:textColor="#E0E0E0"
                android:buttonTint="#FFC107"/>
            <CheckBox android:id="@+id/api_keys_check"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/option_api_keys"
                android:textColor="#E0E0E0"
                android:buttonTint="#FFC107"/>
            <CheckBox android:id="@+id/error_check"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/option_errors"
                android:textColor="#E0E0E0"
                android:buttonTint="#FFC107"/>
            <CheckBox android:id="@+id/directories_check"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/option_public_paths"
                android:textColor="#E0E0E0"
                android:buttonTint="#FFC107"/>
            <CheckBox android:id="@+id/robots_txt_check"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/option_robots"
                android:textColor="#E0E0E0"
                android:buttonTint="#FFC107"/>
        </LinearLayout>

        <!-- Scan results -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/section_results"
            android:textColor="#FFC107"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp"/>

        <LinearLayout
            android:id="@+id/results_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#2C2C2C"
            android:padding="8dp"/>
    </LinearLayout>
</ScrollView>
